---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}
	<div class="social-links">
		<a href="https://github.com/oexenhave" target="_blank" rel="me noopener">GitHub</a>
		<a href="https://dk.linkedin.com/in/oexenhave" target="_blank" rel="me noopener">LinkedIn</a>
		<a href="/rss.xml">RSS</a>
	</div>
</footer>

<style>
	footer {
		padding: 2em 1em 3em;
		text-align: center;
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 0.6em;
	}
	.social-links a {
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
