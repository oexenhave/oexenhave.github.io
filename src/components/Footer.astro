---
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<p class="tabular">&copy; {year} Søren Øxenhave</p>
		<ul>
			<li><a href="https://dk.linkedin.com/in/oexenhave" rel="me">LinkedIn</a></li>
			<li><a href="https://github.com/oexenhave" rel="me">GitHub</a></li>
			<li><a href="mailto:soeren@oexenhave.dk">Email</a></li>
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
		margin-top: 4rem;
		padding: 1.5rem 0 3rem;
		font-size: 0.9rem;
	}

	.wrap {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
	}

	p {
		margin: 0;
		color: var(--ink-soft);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
