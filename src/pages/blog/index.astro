---
// /blog/ was a WordPress "Latest Posts" block, i.e. a generated list.
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog – ${SITE_TITLE}`} description="Posts by Søren Øxenhave." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<PostList />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
	}
</style>
