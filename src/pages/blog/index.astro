---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Writing – ${SITE_TITLE}`}
			description="Notes on engineering, architecture and leading teams."
		/>
	</head>
	<body>
		<Header />
		<main class="prose">
			<h1>Writing</h1>
			<p class="intro">Notes on engineering, architecture and leading the teams that do both.</p>
			<ol class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/${post.data.permalink}/`}>{post.data.title}</a>
							<p class="date tabular">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<p class="excerpt">{post.data.description}</p>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose {
		padding: clamp(2.5rem, 6vw, 4rem) 0 0;
	}

	.intro {
		color: var(--ink-soft);
		margin-bottom: 2.5rem;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.posts li {
		padding: 1.4rem 0;
		border-top: 1px solid var(--rule);
	}

	.posts a {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.012em;
		text-decoration: none;
	}

	.posts a:hover {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.date {
		color: var(--ink-soft);
		font-size: 0.82rem;
		margin: 0.25rem 0 0.4rem;
	}

	.excerpt {
		margin: 0;
		color: var(--ink-soft);
	}
</style>
