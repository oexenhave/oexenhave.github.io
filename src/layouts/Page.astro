---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={frontmatter.title} description={frontmatter.description ?? ''} />
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h1>{frontmatter.title}</h1>
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose {
		padding: clamp(2.5rem, 6vw, 4rem) 0 0;
	}

	/* The CV is a long run of "## Role at Company" followed by an italic date
	   line; give that pair the structure it is missing in Markdown. */
	.prose :global(h2) {
		margin-top: 2.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
	}

	.prose :global(h2 + p em) {
		font-style: normal;
		color: var(--ink-soft);
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}
</style>
